<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Authors>Tedd Hansen</Authors>
    <Company>Tedd Hansen</Company>
    <Description>High-performance, directly mutable bitmap storage and a GPU-backed view for .NET MAUI on Android, iOS, Mac Catalyst, and Windows.</Description>
    <PackageId>Tedd.WriteableBitmap.Maui</PackageId>
    <PackageTags>WriteableBitmap MAUI SkiaSharp Fast Bitmap Pixels Android iOS MacCatalyst Windows</PackageTags>
    <PackageProjectUrl>https://github.com/tedd/Tedd.WritableBitmap</PackageProjectUrl>
    <RepositoryType>Git</RepositoryType>
    <RepositoryUrl>https://github.com/tedd/Tedd.WritableBitmap.git</RepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>1.1.1</Version>
    <PackageReleaseNotes>Adds explicit .NET 10 and .NET 11 preview assets. Optimizes native span access, lease validation, circular buffer selection, premultiplied color packing, and repeated presentation with adaptive image caching. Includes archived BenchmarkDotNet comparisons and regression coverage.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.151.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
