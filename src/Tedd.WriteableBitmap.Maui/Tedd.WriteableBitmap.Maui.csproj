<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Authors>Tedd Hansen</Authors>
    <Company>Tedd Hansen</Company>
    <Description>High-performance, directly mutable bitmap storage and a GPU-backed view for .NET MAUI on Android, iOS, Mac Catalyst, and Windows.</Description>
    <PackageId>Tedd.WriteableBitmap.Maui</PackageId>
    <PackageTags>WriteableBitmap MAUI SkiaSharp Fast Bitmap Pixels Android iOS MacCatalyst Windows</PackageTags>
    <PackageProjectUrl>https://github.com/tedd/Tedd.WritableBitmap</PackageProjectUrl>
    <RepositoryType>Git</RepositoryType>
    <RepositoryUrl>https://github.com/tedd/Tedd.WritableBitmap.git</RepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>1.1.0</Version>
    <PackageReleaseNotes>Adds a directly mutable, platform-native pixel buffer and GPU-backed .NET MAUI view for Android, iOS, Mac Catalyst, and Windows.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.151.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
